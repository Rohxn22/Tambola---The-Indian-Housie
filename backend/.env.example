# Local PostgreSQL connection
DATABASE_URL=jdbc:postgresql://localhost:5432/tambola_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Frontend origin(s), comma-separated for local development
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Render supplies PORT automatically; 8080 is the local default
PORT=8080
